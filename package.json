{
  "name": "prelevements-deau-front",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare-maplibre": "node scripts/prepare-maplibre.mjs",
    "update-icons": "rm -rf .next && yarn react-dsfr update-icons",
    "dev": "yarn prepare-maplibre && yarn react-dsfr update-icons && next dev",
    "build": "yarn prepare-maplibre && yarn react-dsfr update-icons && next build",
    "start": "next start",
    "lint": "xo",
    "test": "ava",
    "test:security": "node --test .github/scripts/*.test.mjs",
    "audit:gate": "node .github/scripts/audit-policy.mjs",
    "storybook": "yarn prepare-maplibre && storybook dev -p 6006",
    "build-storybook": "yarn prepare-maplibre && storybook build"
  },
  "dependencies": {
    "@codegouvfr/react-dsfr": "^1.29.0",
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/server": "^11.11.0",
    "@emotion/styled": "^11.14.1",
    "@fabnum/prelevements-deau-timeseries-parsers": "github:MTES-MCT/prelevements-deau-api.git#workspace=@fabnum/prelevements-deau-timeseries-parsers&head=main",
    "@json2csv/plainjs": "^7.0.6",
    "@mui/icons-material": "^6.5.0",
    "@mui/material": "^6.5.0",
    "@mui/material-nextjs": "^6.5.0",
    "@mui/system": "^6.5.0",
    "@mui/x-charts": "^7.29.1",
    "@mui/x-data-grid": "^7.29.11",
    "date-fns": "^4.1.0",
    "flexsearch": "^0.7.43",
    "lodash-es": "^4.18.1",
    "maplibre-gl": "^6.15.0",
    "next": "^15.5.28",
    "next-auth": "^4.24.15",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@storybook/addon-docs": "^10.6.3",
    "@storybook/nextjs-vite": "^10.6.3",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/react": "^18.3.0",
    "ava": "^6.4.1",
    "eslint-config-xo-nextjs": "^6.3.0",
    "postcss": "^8.5.31",
    "sass": "^1.94.2",
    "storybook": "^10.6.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "xo": "^0.59.3"
  },
  "resolutions": {
    "next/postcss": "8.5.31"
  },
  "xo": {
    "extends": "xo-nextjs",
    "envs": [
      "browser",
      "node",
      "es2021"
    ],
    "parserOptions": {
      "ecmaFeatures": {
        "jsx": true
      }
    },
    "globals": [
      "React"
    ],
    "semicolon": false,
    "space": 2,
    "rules": {
      "react/prop-types": "off",
      "unicorn/prevent-abbreviations": "off",
      "unicorn/prefer-export-from": "off",
      "unicorn/import-style": "off",
      "unicorn/prefer-ternary": "off",
      "unicorn/prefer-module": "off",
      "unicorn/prefer-node-protocol": "off",
      "n/prefer-global/process": "off",
      "n/prefer-global/buffer": "off",
      "import/no-unassigned-import": "off",
      "comma-dangle": [
        "error",
        "never"
      ],
      "import/order": [
        "error",
        {
          "groups": [
            "builtin",
            "external",
            "internal",
            "parent",
            "sibling",
            "index"
          ],
          "pathGroups": [
            {
              "pattern": "react",
              "group": "builtin",
              "position": "before"
            },
            {
              "pattern": "routes/**",
              "group": "internal",
              "position": "before"
            },
            {
              "pattern": "services/**",
              "group": "internal",
              "position": "before"
            },
            {
              "pattern": "helpers/**",
              "group": "internal",
              "position": "before"
            },
            {
              "pattern": "util/**",
              "group": "internal",
              "position": "before"
            },
            {
              "pattern": "contexts/**",
              "group": "internal",
              "position": "before"
            },
            {
              "pattern": "hoc/**",
              "group": "internal",
              "position": "before"
            },
            {
              "pattern": "hooks/**",
              "group": "internal",
              "position": "before"
            },
            {
              "pattern": "components/**",
              "group": "internal",
              "position": "before"
            },
            {
              "pattern": "containers/**",
              "group": "internal",
              "position": "before"
            },
            {
              "pattern": "assets/**",
              "group": "internal",
              "position": "before"
            },
            {
              "pattern": "styles/**",
              "group": "internal",
              "position": "before"
            }
          ],
          "pathGroupsExcludedImportTypes": [
            "react"
          ],
          "newlines-between": "always",
          "alphabetize": {
            "order": "asc",
            "caseInsensitive": true
          }
        }
      ]
    }
  },
  "engines": {
    "node": "22.23.4"
  },
  "packageManager": "yarn@4.6.0",
  "author": "Théophile Merlière <theophile.merliere@gmail.com>",
  "license": "MIT"
}
