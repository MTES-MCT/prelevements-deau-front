{
  "name": "prelevements-deau-front",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare-maplibre": "node scripts/prepare-maplibre.mjs",
    "update-icons": "rm -rf .next && react-dsfr update-icons",
    "dev": "npm run prepare-maplibre && react-dsfr update-icons && next dev --webpack",
    "build": "npm run prepare-maplibre && react-dsfr update-icons && next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "test": "ava",
    "test:browser": "playwright test",
    "storybook": "npm run prepare-maplibre && storybook dev -p 6006",
    "build-storybook": "npm run prepare-maplibre && storybook build"
  },
  "dependencies": {
    "@bprogress/next": "^3.2.12",
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/server": "^11.11.0",
    "@emotion/styled": "^11.14.1",
    "@tanstack/react-virtual": "^3.14.11",
    "crisp-sdk-web": "^1.2.0",
    "date-fns": "^4.4.0",
    "file-type": "^22.0.2",
    "lodash-es": "^4.18.1",
    "maplibre-gl": "^6.9.0",
    "moment": "^2.30.1",
    "next": "^16.3.4",
    "next-auth": "^4.24.15",
    "proj4": "^2.22.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "write-excel-file": "^4.1.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "xlsx-populate": "^1.21.0"
  },
  "devDependencies": {
    "@codegouvfr/react-dsfr": "^1.35.0",
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "^16.3.4",
    "@mui/icons-material": "^9.4.0",
    "@mui/material": "^9.4.0",
    "@mui/material-nextjs": "^9.4.0",
    "@mui/system": "^9.4.0",
    "@mui/x-charts": "^9.13.0",
    "@playwright/test": "^1.63.0",
    "@storybook/addon-docs": "^10.6.0",
    "@storybook/nextjs-vite": "^10.6.0",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@tailwindcss/postcss": "^4.3.3",
    "ava": "^8.0.1",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-x": "^5.19.0",
    "eslint-plugin-react-dom": "^5.19.0",
    "eslint-plugin-react-jsx": "^5.19.0",
    "postcss": "^8.5.28",
    "sass": "^1.104.0",
    "storybook": "^10.6.0",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.0",
    "globals": "^17.12.0"
  },
  "engines": {
    "node": ">= 24.21 < 25",
    "npm": ">= 11.19.1 < 12"
  },
  "overrides": {
    "postcss": "$postcss",
    "next-auth": {
      "uuid": "11.1.1"
    }
  },
  "packageManager": "npm@11.19.1",
  "allowScripts": {
    "@parcel/watcher@2.6.0": false,
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": false
  },
  "author": "Théophile Merlière <theophile.merliere@gmail.com>",
  "license": "MIT"
}
