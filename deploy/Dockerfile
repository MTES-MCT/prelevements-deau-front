FROM node:24-bookworm-slim AS deps
WORKDIR /app

ARG NPM_CONFIG_ALLOW_REMOTE

COPY package.json package-lock.json ./

RUN npm ci

FROM node:24-bookworm-slim AS build
WORKDIR /app

COPY --from=deps /app/node_modules ./node_modules
COPY . .

ARG API_URL
ARG FRONT_URL
ARG NEXTAUTH_URL
ARG NEXT_PUBLIC_API_URL
ARG NEXT_PUBLIC_FRONTEND_URL
ARG NEXT_PUBLIC_PROCEDURE_DS_ID
ARG NEXT_PUBLIC_STORAGE_URL
ARG NEXT_PUBLIC_DEPLOY_ENV
ARG NEXT_PUBLIC_BUILD_SHA
ARG NEXT_PUBLIC_MATOMO_URL
ARG NEXT_PUBLIC_MATOMO_SITE_ID
ARG NEXT_PUBLIC_MATOMO_DISABLED
ARG NEXT_PUBLIC_CRISP_DISABLED

ENV API_URL=$API_URL
ENV FRONT_URL=$FRONT_URL
ENV NEXTAUTH_URL=$NEXTAUTH_URL
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
ENV NEXT_PUBLIC_FRONTEND_URL=$NEXT_PUBLIC_FRONTEND_URL
ENV NEXT_PUBLIC_PROCEDURE_DS_ID=$NEXT_PUBLIC_PROCEDURE_DS_ID
ENV NEXT_PUBLIC_STORAGE_URL=$NEXT_PUBLIC_STORAGE_URL
ENV NEXT_PUBLIC_DEPLOY_ENV=$NEXT_PUBLIC_DEPLOY_ENV
ENV NEXT_PUBLIC_BUILD_SHA=$NEXT_PUBLIC_BUILD_SHA
ENV NEXT_PUBLIC_MATOMO_URL=$NEXT_PUBLIC_MATOMO_URL
ENV NEXT_PUBLIC_MATOMO_SITE_ID=$NEXT_PUBLIC_MATOMO_SITE_ID
ENV NEXT_PUBLIC_MATOMO_DISABLED=$NEXT_PUBLIC_MATOMO_DISABLED
ENV NEXT_PUBLIC_CRISP_DISABLED=$NEXT_PUBLIC_CRISP_DISABLED

RUN npm run build

FROM node:24-bookworm-slim AS runner
WORKDIR /app

ARG API_URL
ARG FRONT_URL
ARG NEXTAUTH_URL

ENV NODE_ENV=production
ENV HOSTNAME=0.0.0.0
ENV PORT=8080
ENV API_URL=$API_URL
ENV FRONT_URL=$FRONT_URL
ENV NEXTAUTH_URL=$NEXTAUTH_URL
EXPOSE 8080

COPY --from=build /app/.next/standalone ./
COPY --from=build /app/.next/static ./.next/static
COPY --from=build /app/public ./public

CMD ["node", "server.js"]
