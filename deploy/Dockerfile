FROM node:24.21.0-alpine3.24@sha256:be80f76cf40ec8e42b9bec49f60a55e0660f30af58d3e5a25530785b30ea67e2 AS base
RUN apk upgrade --no-cache
WORKDIR /app
COPY package.json ./
RUN npm install --global "$(node -p 'require("./package.json").packageManager')" --ignore-scripts --no-audit --no-fund

FROM base AS deps
WORKDIR /app

COPY package.json package-lock.json .npmrc ./

RUN npm ci

FROM base AS build
WORKDIR /app

COPY --from=deps /app/node_modules ./node_modules
COPY . .

ARG API_URL
ARG FRONT_URL
ARG NEXTAUTH_URL
ARG NEXT_PUBLIC_API_URL
ARG NEXT_PUBLIC_FRONTEND_URL
ARG NEXT_PUBLIC_PROCEDURE_DS_ID
ARG NEXT_PUBLIC_STORAGE_URL
ARG NEXT_PUBLIC_DEPLOY_ENV
ARG NEXT_PUBLIC_BUILD_SHA
ARG NEXT_PUBLIC_CRISP_DISABLED

ENV API_URL=$API_URL
ENV FRONT_URL=$FRONT_URL
ENV NEXTAUTH_URL=$NEXTAUTH_URL
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
ENV NEXT_PUBLIC_FRONTEND_URL=$NEXT_PUBLIC_FRONTEND_URL
ENV NEXT_PUBLIC_PROCEDURE_DS_ID=$NEXT_PUBLIC_PROCEDURE_DS_ID
ENV NEXT_PUBLIC_STORAGE_URL=$NEXT_PUBLIC_STORAGE_URL
ENV NEXT_PUBLIC_DEPLOY_ENV=$NEXT_PUBLIC_DEPLOY_ENV
ENV NEXT_PUBLIC_BUILD_SHA=$NEXT_PUBLIC_BUILD_SHA
ENV NEXT_PUBLIC_CRISP_DISABLED=$NEXT_PUBLIC_CRISP_DISABLED

RUN NEXT_TELEMETRY_DISABLED=1 npm run build

FROM base AS runner
WORKDIR /app

ARG API_URL
ARG FRONT_URL
ARG NEXTAUTH_URL

ENV NODE_ENV=production
ENV HOSTNAME=0.0.0.0
ENV PORT=8080
ENV API_URL=$API_URL
ENV FRONT_URL=$FRONT_URL
ENV NEXTAUTH_URL=$NEXTAUTH_URL
EXPOSE 8080

COPY --from=build /app/.next/standalone ./
COPY --from=build /app/.next/static ./.next/static
COPY --from=build /app/public ./public

CMD ["node", "server.js"]
